{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "ATaC Memory",
    "description": "The structured payload stored in an ATaC Memory bundle entry (.atac/.memory/<name>/index.yaml).",
    "type": "object",
    "required": [
        "name",
        "description",
        "steps"
    ],
    "additionalProperties": false,
    "properties": {
        "name": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$",
            "minLength": 1,
            "description": "Unique slug identifier for this memory record."
        },
        "description": {
            "type": "string",
            "minLength": 1,
            "description": "One-sentence summary of what this memory accomplishes."
        },
        "tags": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            },
            "uniqueItems": true,
            "description": "Optional list of topic tags for search and categorization."
        },
        "steps": {
            "type": "array",
            "minItems": 1,
            "description": "Ordered list of guidance steps for the agent. Each step is a hint, not a strict command.",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "anyOf": [
                    {
                        "required": [
                            "note"
                        ]
                    },
                    {
                        "required": [
                            "tool"
                        ]
                    }
                ],
                "properties": {
                    "tool": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Optional: name of the tool to invoke (hint only, not enforced)."
                    },
                    "note": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Free-form guidance, observation, or rationale for the agent."
                    },
                    "args": {
                        "type": "object",
                        "description": "Optional: suggested arguments for the tool call (may be partial or illustrative)."
                    }
                }
            }
        }
    }
}
